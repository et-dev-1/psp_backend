<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{heading}}</title>
  </head>
  <body style="margin:0; padding:0; background-color:#f1f5f9; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color:#0f172a;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#f1f5f9; padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:680px; background-color:#ffffff; border-radius:14px; overflow:hidden; border:1px solid #e2e8f0; box-shadow:0 8px 24px rgba(15,23,42,0.06);">
            <tr>
              <td style="background:linear-gradient(135deg, #0f172a 0%, #1e293b 100%); padding:28px 32px; color:#ffffff;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                  <tr>
                    <td style="vertical-align:middle;">
                      <table role="presentation" cellspacing="0" cellpadding="0">
                        <tr>
                          <td style="vertical-align:middle; padding-right:12px;">
                            {{email_header_logo}}
                          </td>
                          <td style="vertical-align:middle;">
                            <p style="margin:0; font-size:20px; font-weight:700; letter-spacing:0.2px; color:#ffffff;">{{company_name}}</p>
                            <p style="margin:4px 0 0 0; font-size:12px; line-height:18px; color:#cbd5e1;">{{company_address}}</p>
                          </td>
                        </tr>
                      </table>
                    </td>
                    <td style="text-align:right; vertical-align:middle;">
                      <span style="display:inline-block; padding:6px 12px; border-radius:999px; background-color:{{badge_bg}}; color:{{badge_text}}; font-size:11px; font-weight:700; letter-spacing:0.5px; text-transform:uppercase;">
                        {{badge_label}}
                      </span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding:32px;">
                <h1 style="margin:0 0 12px 0; font-size:22px; line-height:28px; font-weight:700; color:#0f172a;">{{heading}}</h1>
                {{body_html}}
              </td>
            </tr>

            {{email_footer}}
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
