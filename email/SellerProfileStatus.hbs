<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Seller Profile Status Update</title>
  </head>
  <body style="margin:0; padding:0; background-color:#f1f5f9; font-family:Arial, Helvetica, sans-serif; color:#0f172a;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#f1f5f9; padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:760px; background-color:#ffffff; border-radius:16px; overflow:hidden; border:1px solid #e2e8f0;">
            <tr>
              <td style="height:4px; background:linear-gradient(90deg, #9333ea 0%, #ea580c 100%); font-size:0; line-height:0;">&nbsp;</td>
            </tr>
            <tr>
              <td style="padding:28px 32px; background:linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color:#ffffff;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                  <tr>
                    <td>
                      <table role="presentation" cellspacing="0" cellpadding="0" style="margin-bottom:14px;">
                        <tr>
                          <td style="vertical-align:middle; padding-right:14px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                              <tr>
                                <td style="width:44px;height:44px;border-radius:10px;text-align:center;vertical-align:middle;">{{email_header_logo}}</td>
                              </tr>
                            </table>
                          </td>
                          <td style="vertical-align:middle;">
                            <p style="margin:0; font-size:18px; line-height:24px; font-weight:700; color:#ffffff;">{{company_name}}</p>
                            <p style="margin:4px 0 0 0; font-size:12px; line-height:18px; color:#cbd5e1;">{{company_address}}</p>
                          </td>
                        </tr>
                      </table>
                      <h1 style="margin:0; font-size:26px; line-height:32px; font-weight:700; letter-spacing:-0.2px;">Seller Profile Update</h1>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding:28px 32px 16px 32px;">
                <p style="margin:0 0 8px 0; font-size:16px; font-weight:600; color:#0f172a;">Hello <strong>{{seller_name}}</strong>,</p>
                <p style="margin:0; font-size:14px; line-height:22px; color:#475569;">{{intro_text}}</p>
              </td>
            </tr>

            <tr>
              <td style="padding:0 32px 20px 32px;">
                <table role="presentation" cellspacing="0" cellpadding="0">
                  <tr>
                    <td style="background:{{status_bg}}; border-radius:8px; padding:10px 18px;">
                      <p style="margin:0; font-size:12px; font-weight:700; color:{{status_color}}; text-transform:uppercase; letter-spacing:0.6px;">{{status_label}}</p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            {{reason_block}}

            <tr>
              <td style="padding:0 32px 24px 32px;">
                <div style="border:1px solid #e2e8f0; border-radius:12px; overflow:hidden; background-color:#ffffff;">
                  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse; width:100%;">
                    <tr style="background-color:#f8fafc;">
                      <td style="padding:12px 16px; font-size:13px; font-weight:600; color:#475569; width:180px; border-bottom:1px solid #e2e8f0;">Account Email</td>
                      <td style="padding:12px 16px; font-size:13px; color:#0f172a; border-bottom:1px solid #e2e8f0;">{{seller_email}}</td>
                    </tr>
                    <tr style="background-color:#ffffff;">
                      <td style="padding:12px 16px; font-size:13px; font-weight:600; color:#475569; border-bottom:1px solid #e2e8f0;">Profile Status</td>
                      <td style="padding:12px 16px; font-size:13px; font-weight:700; color:#0f172a; border-bottom:1px solid #e2e8f0;">{{status_label}}</td>
                    </tr>
                    <tr style="background-color:#f8fafc;">
                      <td style="padding:12px 16px; font-size:13px; font-weight:600; color:#475569;">Updated</td>
                      <td style="padding:12px 16px; font-size:13px; color:#0f172a;">{{updated_at}}</td>
                    </tr>
                  </table>
                </div>
              </td>
            </tr>

            <tr>
              <td style="padding:0 32px 28px 32px;">
                <a href="{{cta_url}}" style="display:inline-block; padding:13px 28px; background:{{cta_bg}}; color:#ffffff; text-decoration:none; border-radius:10px; font-weight:700; font-size:14px;">{{cta_label}}</a>
              </td>
            </tr>

            {{email_footer}}
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
